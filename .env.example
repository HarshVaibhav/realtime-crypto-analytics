# Copy this file to .env and replace the example SQL Server name.
# Do not commit your real .env file or credentials.

SQL_SERVER=YOUR_SERVER_NAME\SQLEXPRESS
SQL_DATABASE=CryptoAnalyticsDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Use yes for Windows Authentication; use no for SQL Server Authentication.
SQL_TRUSTED_CONNECTION=yes

# Required only when SQL_TRUSTED_CONNECTION=no.
SQL_USERNAME=
SQL_PASSWORD=

# Set to yes for a trusted local development certificate.
SQL_TRUST_SERVER_CERTIFICATE=yes
